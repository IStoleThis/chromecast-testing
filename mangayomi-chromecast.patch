index 0000000..c189556
--- /dev/null
+++ b/lib/modules/anime/cast/cast_discovery.dart
@@ -0,0 +1,85 @@
+import 'dart:async';
+import 'dart:io';
+
+import 'package:bonsoir/bonsoir.dart';
+import 'package:dart_cast/dart_cast.dart';
+
+/// Whether device discovery should go through the operating system's own
+/// Bonjour / NSD support instead of dart_cast's pure-Dart mDNS.
+///
+/// iOS (and sandboxed macOS) block raw multicast sockets unless the app holds
+/// an Apple-granted entitlement, which a sideloaded build can't have. Android
+/// is also more reliable through NSD, since the OS manages the multicast lock.
+bool get useNativeDiscovery =>
+    Platform.isIOS || Platform.isMacOS || Platform.isAndroid;
+
+/// An [MdnsLookup] for dart_cast backed by Bonsoir.
+///
+/// dart_cast asks for `_googlecast._tcp.local`; Bonsoir wants the type
+/// without the `.local` suffix.
+Stream<MdnsServiceInfo> bonsoirLookup(String serviceType) {
+  final type = serviceType.replaceFirst(RegExp(r'\.local\.?$'), '');
+
+  BonsoirDiscovery? discovery;
+  StreamSubscription<BonsoirDiscoveryEvent>? subscription;
+  late final StreamController<MdnsServiceInfo> controller;
+
+  Future<void> shutdown() async {
+    final sub = subscription;
+    final disc = discovery;
+    subscription = null;
+    discovery = null;
+    await sub?.cancel();
+    try {
+      await disc?.stop();
+    } catch (_) {}
+  }
+
+  controller = StreamController<MdnsServiceInfo>(
+    onListen: () async {
+      try {
+        final disc = BonsoirDiscovery(type: type);
+        discovery = disc;
+        await disc.initialize();
+        subscription = disc.eventStream!.listen((event) {
+          switch (event) {
+            case BonsoirDiscoveryServiceFoundEvent():
+              // Resolving is what fills in the address and the TXT records.
+              event.service!.resolve(disc.serviceResolver);
+            case BonsoirDiscoveryServiceResolvedEvent():
+              final BonsoirService? service = event.service;
+              if (service == null || controller.isClosed) return;
+              final host = _preferIpv4(service.hostAddresses);
+              if (host == null) return;
+              controller.add(
+                MdnsServiceInfo(
+                  name: service.name,
+                  host: host,
+                  port: service.port,
+                  txtRecords: Map<String, String>.from(service.attributes),
+                ),
+              );
+            default:
+              break;
+          }
+        });
+        await disc.start();
+      } catch (error, stack) {
+        if (!controller.isClosed) controller.addError(error, stack);
+      }
+    },
+    onCancel: shutdown,
+  );
+  return controller.stream;
+}
+
+/// A Chromecast is reached over a plain TLS socket, which can't take an IPv6
+/// link-local address without a scope id, so prefer IPv4.
+String? _preferIpv4(List<String> addresses) {
+  for (final address in addresses) {
+    if (InternetAddress.tryParse(address)?.type == InternetAddressType.IPv4) {
+      return address;
+    }
+  }
+  return null;
+}
diff --git a/lib/modules/anime/cast/cast_media_builder.dart b/lib/modules/anime/cast/cast_media_builder.dart
new file mode 100644
index 0000000..3c80067
--- /dev/null
+++ b/lib/modules/anime/cast/cast_media_builder.dart
@@ -0,0 +1,114 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:dart_cast/dart_cast.dart';
+import 'package:http/http.dart' as http;
+import 'package:mangayomi/models/video.dart' as vid;
+
+/// Builds the [CastMedia] for what the player is currently showing.
+///
+/// Remote streams keep the headers (Referer, cookies, ...) the source needs;
+/// dart_cast's proxy adds them when the TV fetches the stream, since a
+/// Chromecast can't send custom headers itself.
+Future<CastMedia> buildCastMedia({
+  required String url,
+  required bool isLocal,
+  Map<String, String>? headers,
+  String? title,
+  Duration? start,
+  List<vid.Track>? subtitles,
+}) async {
+  final startPosition = (start != null && start > Duration.zero) ? start : null;
+
+  if (isLocal) {
+    return CastMedia.file(
+      filePath: url,
+      type: _typeFromExtension(url) ?? CastMediaType.mp4,
+      title: title,
+      startPosition: startPosition,
+    );
+  }
+
+  final type = await detectCastType(url, headers: headers);
+  final castSubtitles = _castSubtitles(subtitles);
+  return CastMedia(
+    url: url,
+    type: type,
+    httpHeaders: headers ?? const {},
+    title: title,
+    startPosition: startPosition,
+    subtitles: castSubtitles,
+    defaultSubtitle: _defaultSubtitle(castSubtitles),
+  );
+}
+
+/// Works out whether [url] is an HLS playlist or a plain file.
+///
+/// The extension decides when it is conclusive. Some sources serve HLS from
+/// URLs with no extension, so those get a tiny ranged request to look for the
+/// `#EXTM3U` header; anything that can't be read is treated as an MP4.
+Future<CastMediaType> detectCastType(
+  String url, {
+  Map<String, String>? headers,
+}) async {
+  final byExtension = _typeFromExtension(url);
+  if (byExtension != null) return byExtension;
+
+  try {
+    final response = await http
+        .get(Uri.parse(url), headers: {...?headers, 'Range': 'bytes=0-63'})
+        .timeout(const Duration(seconds: 6));
+    final head = utf8.decode(
+      response.bodyBytes.take(64).toList(),
+      allowMalformed: true,
+    );
+    if (head.trimLeft().startsWith('#EXTM3U')) return CastMediaType.hls;
+  } catch (_) {}
+  return CastMediaType.mp4;
+}
+
+CastMediaType? _typeFromExtension(String url) {
+  final path = (Uri.tryParse(url)?.path ?? url).toLowerCase();
+  if (path.endsWith('.m3u8') || path.contains('.m3u8/')) {
+    return CastMediaType.hls;
+  }
+  if (path.endsWith('.mp4') || path.endsWith('.m4v')) return CastMediaType.mp4;
+  if (path.endsWith('.mkv')) return CastMediaType.mkv;
+  if (path.endsWith('.ts')) return CastMediaType.mpegTs;
+  // A playlist hidden in the query string, e.g. `/proxy?url=...index.m3u8`.
+  if (url.toLowerCase().contains('.m3u8')) return CastMediaType.hls;
+  return null;
+}
+
+/// The Default Media Receiver shows WebVTT only, so SRT is converted by
+/// dart_cast and styled formats like ASS can't be sent.
+List<CastSubtitle> _castSubtitles(List<vid.Track>? tracks) {
+  final result = <CastSubtitle>[];
+  for (final track in tracks ?? const <vid.Track>[]) {
+    final file = track.file;
+    if (file == null || file.isEmpty) continue;
+    final path = (Uri.tryParse(file)?.path ?? file).toLowerCase();
+    final String format;
+    if (path.endsWith('.vtt')) {
+      format = 'vtt';
+    } else if (path.endsWith('.srt')) {
+      format = 'srt';
+    } else {
+      continue;
+    }
+    final label = (track.label == null || track.label!.isEmpty)
+        ? 'Subtitles ${result.length + 1}'
+        : track.label!;
+    result.add(
+      CastSubtitle(url: file, label: label, language: 'und', format: format),
+    );
+  }
+  return result;
+}
+
+CastSubtitle? _defaultSubtitle(List<CastSubtitle> subtitles) {
+  for (final subtitle in subtitles) {
+    if (subtitle.label.toLowerCase().contains('english')) return subtitle;
+  }
+  return null;
+}
diff --git a/lib/modules/anime/cast/cast_sheet.dart b/lib/modules/anime/cast/cast_sheet.dart
new file mode 100644
index 0000000..d027942
--- /dev/null
+++ b/lib/modules/anime/cast/cast_sheet.dart
@@ -0,0 +1,347 @@
+import 'package:dart_cast/dart_cast.dart' show CastDevice;
+import 'package:material_ui/material_ui.dart';
+
+import 'cast_controller.dart';
+
+/// The cast icon for the player's top bar. It fills in while casting.
+class CastButton extends StatelessWidget {
+  const CastButton({
+    super.key,
+    required this.controller,
+    required this.onPressed,
+  });
+
+  final CastController controller;
+  final VoidCallback onPressed;
+
+  @override
+  Widget build(BuildContext context) {
+    return ListenableBuilder(
+      listenable: controller,
+      builder: (context, _) {
+        final casting = controller.isCasting;
+        return IconButton(
+          tooltip: casting
+              ? 'Casting to ${controller.device?.name ?? 'TV'}'
+              : 'Cast to TV',
+          icon: Icon(
+            casting ? Icons.cast_connected : Icons.cast,
+            color: Colors.white,
+          ),
+          onPressed: onPressed,
+        );
+      },
+    );
+  }
+}
+
+/// Opens the device picker, which turns into the remote while casting.
+Future<void> showCastSheet(
+  BuildContext context, {
+  required CastController controller,
+  required void Function(CastDevice device) onDeviceSelected,
+  required VoidCallback onStopCasting,
+}) {
+  return showModalBottomSheet<void>(
+    context: context,
+    isScrollControlled: true,
+    showDragHandle: true,
+    constraints: const BoxConstraints(maxWidth: 520),
+    builder: (_) => CastSheet(
+      controller: controller,
+      onDeviceSelected: onDeviceSelected,
+      onStopCasting: onStopCasting,
+    ),
+  );
+}
+
+class CastSheet extends StatefulWidget {
+  const CastSheet({
+    super.key,
+    required this.controller,
+    required this.onDeviceSelected,
+    required this.onStopCasting,
+  });
+
+  final CastController controller;
+  final void Function(CastDevice device) onDeviceSelected;
+  final VoidCallback onStopCasting;
+
+  @override
+  State<CastSheet> createState() => _CastSheetState();
+}
+
+class _CastSheetState extends State<CastSheet> {
+  CastController get _cast => widget.controller;
+
+  @override
+  void initState() {
+    super.initState();
+    if (!_cast.isBusy) _cast.discover();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return SafeArea(
+      child: ListenableBuilder(
+        listenable: _cast,
+        builder: (context, _) {
+          final theme = Theme.of(context);
+          final casting = _cast.isCasting;
+          return Padding(
+            padding: const EdgeInsets.fromLTRB(20, 0, 20, 16),
+            child: SingleChildScrollView(
+              child: Column(
+                mainAxisSize: MainAxisSize.min,
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Row(
+                    children: [
+                      Icon(casting ? Icons.cast_connected : Icons.cast),
+                      const SizedBox(width: 12),
+                      Expanded(
+                        child: Text(
+                          casting
+                              ? 'Casting to ${_cast.device?.name ?? 'TV'}'
+                              : 'Cast to a TV',
+                          style: theme.textTheme.titleMedium,
+                          overflow: TextOverflow.ellipsis,
+                        ),
+                      ),
+                      if (!_cast.isBusy)
+                        IconButton(
+                          tooltip: 'Search again',
+                          icon: const Icon(Icons.refresh),
+                          onPressed: _cast.status == CastStatus.searching
+                              ? null
+                              : _cast.discover,
+                        ),
+                    ],
+                  ),
+                  if (_cast.error != null)
+                    Padding(
+                      padding: const EdgeInsets.only(top: 8),
+                      child: Text(
+                        _cast.error!,
+                        style: TextStyle(color: theme.colorScheme.error),
+                      ),
+                    ),
+                  const SizedBox(height: 8),
+                  if (casting)
+                    _RemotePanel(
+                      controller: _cast,
+                      onStopCasting: widget.onStopCasting,
+                    )
+                  else if (_cast.status == CastStatus.connecting)
+                    Padding(
+                      padding: const EdgeInsets.symmetric(vertical: 24),
+                      child: Row(
+                        children: [
+                          const SizedBox.square(
+                            dimension: 20,
+                            child: CircularProgressIndicator(strokeWidth: 2),
+                          ),
+                          const SizedBox(width: 16),
+                          Expanded(
+                            child: Text(
+                              'Connecting to ${_cast.device?.name ?? 'TV'}…',
+                            ),
+                          ),
+                        ],
+                      ),
+                    )
+                  else
+                    _DeviceList(
+                      controller: _cast,
+                      onDeviceSelected: widget.onDeviceSelected,
+                    ),
+                ],
+              ),
+            ),
+          );
+        },
+      ),
+    );
+  }
+}
+
+class _DeviceList extends StatelessWidget {
+  const _DeviceList({required this.controller, required this.onDeviceSelected});
+
+  final CastController controller;
+  final void Function(CastDevice device) onDeviceSelected;
+
+  @override
+  Widget build(BuildContext context) {
+    final searching = controller.status == CastStatus.searching;
+    final devices = controller.devices;
+
+    if (devices.isEmpty) {
+      return Padding(
+        padding: const EdgeInsets.symmetric(vertical: 24),
+        child: searching
+            ? const Row(
+                children: [
+                  SizedBox.square(
+                    dimension: 20,
+                    child: CircularProgressIndicator(strokeWidth: 2),
+                  ),
+                  SizedBox(width: 16),
+                  Expanded(child: Text('Looking for TVs on your Wi-Fi…')),
+                ],
+              )
+            : const Text(
+                'No Chromecast found. Check that this device and the TV are on '
+                'the same Wi-Fi network, then search again.',
+              ),
+      );
+    }
+
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        if (searching) const LinearProgressIndicator(),
+        for (final device in devices)
+          ListTile(
+            contentPadding: EdgeInsets.zero,
+            leading: const Icon(Icons.tv),
+            title: Text(device.name),
+            subtitle: (device.metadata['md'] ?? '').isEmpty
+                ? null
+                : Text(device.metadata['md']!),
+            onTap: () => onDeviceSelected(device),
+          ),
+      ],
+    );
+  }
+}
+
+class _RemotePanel extends StatefulWidget {
+  const _RemotePanel({required this.controller, required this.onStopCasting});
+
+  final CastController controller;
+  final VoidCallback onStopCasting;
+
+  @override
+  State<_RemotePanel> createState() => _RemotePanelState();
+}
+
+class _RemotePanelState extends State<_RemotePanel> {
+  double? _seekDrag;
+  double? _volumeDrag;
+
+  CastController get _cast => widget.controller;
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        ValueListenableBuilder<Duration>(
+          valueListenable: _cast.duration,
+          builder: (context, total, _) => ValueListenableBuilder<Duration>(
+            valueListenable: _cast.position,
+            builder: (context, position, _) => _seekBar(position, total),
+          ),
+        ),
+        Row(
+          mainAxisAlignment: MainAxisAlignment.center,
+          children: [
+            IconButton(
+              iconSize: 32,
+              tooltip: 'Back 10 seconds',
+              icon: const Icon(Icons.replay_10),
+              onPressed: () => _cast.seekBy(const Duration(seconds: -10)),
+            ),
+            IconButton(
+              iconSize: 56,
+              tooltip: _cast.isPlaying ? 'Pause' : 'Play',
+              icon: Icon(
+                _cast.isPlaying
+                    ? Icons.pause_circle_filled
+                    : Icons.play_circle_filled,
+              ),
+              onPressed: _cast.togglePlayPause,
+            ),
+            IconButton(
+              iconSize: 32,
+              tooltip: 'Forward 10 seconds',
+              icon: const Icon(Icons.forward_10),
+              onPressed: () => _cast.seekBy(const Duration(seconds: 10)),
+            ),
+          ],
+        ),
+        Row(
+          children: [
+            const Icon(Icons.volume_down),
+            Expanded(
+              child: Slider(
+                value: _volumeDrag ?? _cast.volume ?? 1.0,
+                onChanged: (value) => setState(() => _volumeDrag = value),
+                onChangeEnd: (value) {
+                  setState(() => _volumeDrag = null);
+                  _cast.setVolume(value);
+                },
+              ),
+            ),
+            const Icon(Icons.volume_up),
+          ],
+        ),
+        const SizedBox(height: 8),
+        SizedBox(
+          width: double.infinity,
+          child: FilledButton.tonalIcon(
+            onPressed: widget.onStopCasting,
+            icon: const Icon(Icons.cast_connected),
+            label: const Text('Stop casting'),
+          ),
+        ),
+      ],
+    );
+  }
+
+  Widget _seekBar(Duration position, Duration total) {
+    final enabled = total > Duration.zero;
+    final max = enabled ? total.inMilliseconds.toDouble() : 1.0;
+    final current = (_seekDrag ?? position.inMilliseconds.toDouble())
+        .clamp(0.0, max)
+        .toDouble();
+    return Column(
+      children: [
+        Slider(
+          value: enabled ? current : 0.0,
+          max: max,
+          onChanged: enabled
+              ? (value) => setState(() => _seekDrag = value)
+              : null,
+          onChangeEnd: enabled
+              ? (value) {
+                  setState(() => _seekDrag = null);
+                  _cast.seek(Duration(milliseconds: value.round()));
+                }
+              : null,
+        ),
+        Padding(
+          padding: const EdgeInsets.symmetric(horizontal: 16),
+          child: Row(
+            mainAxisAlignment: MainAxisAlignment.spaceBetween,
+            children: [
+              Text(_format(Duration(milliseconds: current.round()))),
+              Text(enabled ? _format(total) : '--:--'),
+            ],
+          ),
+        ),
+      ],
+    );
+  }
+
+  static String _format(Duration value) {
+    String two(int n) => n.toString().padLeft(2, '0');
+    final hours = value.inHours;
+    final minutes = value.inMinutes.remainder(60);
+    final seconds = value.inSeconds.remainder(60);
+    return hours > 0
+        ? '$hours:${two(minutes)}:${two(seconds)}'
+        : '${two(minutes)}:${two(seconds)}';
+  }
+}
